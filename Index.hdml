<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>English to Sinhala Translator</title>
<style>
*{box-sizing:border-box;font-family:Arial,sans-serif}
body{margin:0;background:#6d28d9;min-height:100vh;display:flex;justify-content:center;align-items:center;padding:15px}
.box{background:white;width:100%;max-width:480px;border-radius:20px;padding:22px;box-shadow:0 10px 30px rgba(0,0,0,.3)}
h2{text-align:center;color:#4c1d95;margin:0 0 5px}
p{text-align:center;color:#666;font-size:13px;margin:0 0 15px}
label{font-weight:bold;font-size:14px}
textarea{width:100%;height:110px;border:2px solid #ddd;border-radius:12px;padding:12px;font-size:17px;margin:8px 0 12px;outline:none;resize:none}
textarea:focus{border-color:#7c3aed}
.btns{display:flex;gap:10px}
button{flex:1;padding:13px;border:none;border-radius:12px;font-size:16px;font-weight:bold;cursor:pointer;color:white}
#transBtn{background:#7c3aed}
#clearBtn{background:#ef4444}
#result{background:#f5f3ff;border:2px dashed #a78bfa;border-radius:12px;padding:15px;min-height:80px;font-size:20px;margin-top:15px;word-wrap:break-word}
.small{font-size:12px;color:#888;text-align:center;margin-top:10px}
</style>
</head>
<body>
<div class="box">
<h2>🇬🇧 ➡️ 🇱🇰 Translator</h2>
<p>English to Sinhala Translate</p>

<label>English Type Karanna:</label>
<textarea id="input" placeholder="Ex: How are you?"></textarea>

<div class="btns">
<button id="transBtn" onclick="translateText()">Translate</button>
<button id="clearBtn" onclick="clearAll()">Clear</button>
</div>

<div id="result">Sinhala eka methana penwai...</div>
<div class="small">Made by Shantha Bandara</div>
</div>

<script>
async function translateText(){
  let text = document.getElementById('input').value.trim();
  let result = document.getElementById('result');
  if(!text){ result.innerHTML = "Issellama English word ekak type karanna!"; return; }
  result.innerHTML = "Translate wenawa... ⏳";
  try{
    let res = await fetch(`https://api.mymemory.translated.net/get?q=${encodeURIComponent(text)}&langpair=en|si`);
    let data = await res.json();
    let translated = data.responseData.translatedText;
    result.innerHTML = translated;
  }catch(e){
    result.innerHTML = "Internet nadda? Ayeth try karanna.";
  }
}
function clearAll(){
  document.getElementById('input').value = "";
  document.getElementById('result').innerHTML = "Sinhala eka methana penwai...";
}
</script>
</body>
</html>
